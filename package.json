{
  "name": "bingo-multiplayer-app",
  "version": "1.0.0",
  "description": "Multiplayer Bingo game for browser and mobile with real-time Socket.IO backend",
  "scripts": {
    "dev:server": "npm run start --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build --workspace=client",
    "start": "npm run build && node server/index.js",
    "test": "node server/test-game.js"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
